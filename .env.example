# ─────────────────────────────────────────────────────────────
#  AFFECTA — Configuration d'environnement
#  Copier ce fichier en `.env` puis adapter les valeurs.
#  Le fichier .env ne doit JAMAIS être committé ni exposé.
# ─────────────────────────────────────────────────────────────

APP_NAME="AFFECTA"
APP_TAGLINE="Construisons le futur du digital."
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=fr
ASSET_VERSION=1.0.0

# ── Base de données ──────────────────────────────────────────
# mysql (production) | sqlite (démo locale sans serveur)
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=affecta
DB_USERNAME=affecta
DB_PASSWORD=change-me-in-production

# ── Sessions & sécurité ──────────────────────────────────────
SESSION_NAME=affecta_session
# Passer à true dès que le site est servi en HTTPS
SESSION_SECURE=false
HSTS_ENABLED=false
# Autorise l'encadrement en iframe : à laisser à false en production
ALLOW_IFRAME_EMBED=false
# Proxies de confiance (séparés par des virgules), vide en direct
TRUSTED_PROXIES=

# ── Contact & anti-spam ──────────────────────────────────────
CONTACT_RECIPIENT=contact@affecta.dev
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600
# Délai minimal (secondes) entre l'ouverture du formulaire et l'envoi
CONTACT_MIN_DELAY=3

# ── Envoi d'emails ───────────────────────────────────────────
# log (écrit dans storage/logs) | smtp
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@affecta.dev
MAIL_FROM_NAME="AFFECTA"

# ── Société (footer, SEO, données structurées) ───────────────
COMPANY_NAME="AFFECTA SAS"
COMPANY_EMAIL=contact@affecta.dev
COMPANY_PHONE="+261 34 00 000 00"
COMPANY_ADDRESS="Immeuble Skyline, Antananarivo 101, Madagascar"
COMPANY_CITY=Antananarivo
COMPANY_COUNTRY=Madagascar
SOCIAL_LINKEDIN=https://www.linkedin.com/company/affecta
SOCIAL_GITHUB=https://github.com/affecta
SOCIAL_X=https://x.com/affecta
SOCIAL_YOUTUBE=https://www.youtube.com/@affecta

# ── Compte administrateur créé par le seeder ─────────────────
# Laisser vide en production : un mot de passe aléatoire est alors généré
# et affiché une seule fois par `php bin/seed.php`.
SEED_ADMIN_EMAIL=admin@affecta.dev
SEED_ADMIN_PASSWORD=

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
