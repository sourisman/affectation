{
    "name": "affecta/platform",
    "description": "AFFECTA — Plateforme de pilotage des affectations et de la mobilité interne. Socle PHP 8.3 (MVC maison), API AJAX, administration, Docker.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "phpmailer/phpmailer": "Envoi SMTP réel des notifications (sinon driver 'log').",
        "mpdf/mpdf": "Export PDF serveur des rapports d'affectation.",
        "ext-pdo_mysql": "Base MySQL/MariaDB en production.",
        "ext-intl": "Formatage localisé avancé."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8080 -t public public/router.php",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "setup": ["@migrate", "@seed"]
    }
}
